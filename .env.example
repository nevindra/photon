# Copy to `.env` and fill in. `docker compose` reads `.env` automatically.

# --- Required -------------------------------------------------------------------------------
# OTLP ingest bearer token (treat like a password). Generate: openssl rand -hex 32
PHOTON_INGEST_TOKEN=change-me-ingest-token
# Session cookie signing secret, >= 32 bytes. Generate: openssl rand -hex 32
PHOTON_SESSION_SECRET=change-me-session-secret-at-least-32-bytes

# --- Optional tuning (defaults shown) -------------------------------------------------------
# PHOTON_RETENTION_DAYS=30
# PHOTON_PROMOTED_ATTRIBUTES=service.name,host.name,deployment.environment
# PHOTON_INGEST_MAX_IN_FLIGHT=256

# --- Service rollup (spans -> photon.service.* / photon.operation.* metrics) -----------------
# Always on; see docs/subsystems/rollup.md. `lag_secs` is how long a 60s bucket stays open for
# late spans before it is published ONCE and never revisited — spans later than that never reach
# the rollup. `top_operations` is per (service, environment); the tail sums into `__other__`.
# PHOTON_ROLLUP_ENABLED=true
# PHOTON_ROLLUP_INTERVAL_SECS=60
# PHOTON_ROLLUP_LAG_SECS=600
# PHOTON_ROLLUP_TOP_OPERATIONS=50

# --- Durable S3 tier (only used with `--profile durable`; see deploy/README.md) -------------
# Uncommenting these enables hot->durable replication to the bundled Garage. The key id/secret
# below are the compose defaults and MUST stay valid Garage formats (id = "GK" + 24 hex chars;
# secret = 64 hex chars) or `garage key import` rejects them. Regenerate for production:
#   id:     printf 'GK%s' "$(openssl rand -hex 12)"
#   secret: openssl rand -hex 32
# PHOTON_DURABLE_ENDPOINT=http://garage:3900
# PHOTON_DURABLE_BUCKET=photon
# PHOTON_DURABLE_REGION=garage
# PHOTON_DURABLE_ACCESS_KEY_ID=GK43ba46c38ae6886c283896c1
# PHOTON_DURABLE_SECRET_ACCESS_KEY=1efa8a1bf2156fa1e93ddc088339993ddf56501970e82e87a0282716237f1d62

# --- Docker fleet management (docs/subsystems/deploy.md) ---
# The URL agents on customer hosts dial to reach THIS Photon (as their LAN sees it).
# PHOTON_DEPLOY_SERVER_ORIGIN=https://photon.example
# Where those agents send metrics; defaults to the server origin on the ingest port (4318).
# PHOTON_DEPLOY_INGEST_ORIGIN=http://photon.example:4318
# PHOTON_DEPLOY_ENABLED=true
# PHOTON_DEPLOY_SSH_BOOTSTRAP=true
# PHOTON_DEPLOY_SECRET_KEY_FILE=/data/deploy.key
# PHOTON_DEPLOY_AGENT_BINARIES_DIR=/data/agents
